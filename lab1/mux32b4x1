module mux32b4x1
(
    output logic [31:0] f,
    input  logic [31:0] a, b, c, d,
    input  logic [1:0] sel
);

    logic [31:0] f1, f2, f3, f4;
    logic [1:0] n_sel;

  not g1(n_sel[1], sel[1]),
      g2(n_sel[0], sel[0]);

  and g3(f1, a, {32{n_sel[1]}}, {32{n_sel[0]}}),
      g4(f2, b, {32{n_sel[1]}}, {32{sel[0]}}),
      g5(f3, c, {32{sel[1]}}, {32{n_sel[0]}}),
      g6(f4, d, {32{sel[1]}}, {32{sel[0]}});

  or g7(f, f1, f2, f3, f4);

endmodule
