
module mux32b4x1
(
    output logic [31:0] f,
    input  logic [31:0] a, b, c, d,
    input  logic [1:0] sel
);

    assign f = ({32{~sel[1] & ~sel[0]}} & a) |
               ({32{~sel[1] &  sel[0]}} & b) |
               ({32{ sel[1] & ~sel[0]}} & c) |
               ({32{ sel[1] &  sel[0]}} & d);

endmodule
