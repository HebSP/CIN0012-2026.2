
`timescale 1ns/1ps

module tb_mux32b4x1;

   logic [31:0] a, b, c, d;
   logic [1:0] sel;
   logic [31:0] muxOut;

   logic [31:0] values [0:3];

   mux4x1 dut(
      .f(muxOut),
      .a(a),
      .b(b),
      .c(c),
      .d(d),
      .sel(sel)
   );

   initial begin

      values[0] = 32'h00000000;
      values[1] = 32'h55555555;
      values[2] = 32'hAAAAAAAA;
      values[3] = 32'hFFFFFFFF;

      $monitor($time,
         " | a = %h | b = %h | c = %h | d = %h | sel = %b | muxOut = %h",
         a, b, c, d, sel, muxOut);

      for (int i = 0; i < 4; i++) begin

         a = values[i];
         b = values[(i+1) % 4];
         c = values[(i+2) % 4];
         d = values[(i+3) % 4];

         for (int j = 0; j < 4; j++) begin
            sel = j;
            #10;
         end

      end

      $stop;

   end

endmodule: tb_mux32b4x1
